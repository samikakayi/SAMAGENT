# Python / tooling
.venv/
# scripts/install.ps1 moves an older venv aside as .venv.old-<timestamp>
.venv.old-*/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Scratch output of tests and scripts (pytest --basetemp, logs, probes)
work/
logs/
*.log

# Local configuration and secrets: never committed. SAM 2 reads them at
# runtime from SAM_HOME (.env and the DPAPI store data/secrets.json).
.env
data/secrets.json
data/*.sqlite3
data/*.sqlite3-*
data/*.db
data/*.db-*
data/*.jsonl
data/logs/

workspace/*
!workspace/.gitkeep

.freebuff/*.log
.freebuff/*.log.err
.freebuff/project-id
