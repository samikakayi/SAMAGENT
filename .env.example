# SAM 2 -- variables it reads from <SAM_HOME>\.env (or the process environment).
# Copy to .env and fill in only what you use. Never commit .env.
#
# Keys pasted in SAM's Settings page are stored encrypted (Windows DPAPI) in
# <SAM_HOME>\data\secrets.json instead -- prefer that. Lookup order for a key:
# process environment, then .env, then the key store. SAM never copies .env
# values into its own environment, so programs it starts never inherit them.

# --- OmniRoute (local OpenAI-compatible gateway, http://127.0.0.1:20128) --------------------
LITELLM_BASE_URL=
# client key for the gateway (LITELLM_MASTER_KEY is accepted as a fallback name)
LITELLM_API_KEY=
LITELLM_MASTER_KEY=
# combo names on the gateway (defaults: sam-fast, sam-strong, sam-vision)
LITELLM_FAST_MODEL=
LITELLM_STRONG_MODEL=
LITELLM_VISION_MODEL=

# --- provider keys (optional here: normally pasted in Settings) -------------------------------
# Gemini: https://aistudio.google.com/apikey -- AIza... or AQ.... (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
KURDISHTTS_STT_API_KEY=
KURDISHTTS_TTS_API_KEY=
N8N_API_KEY=
GOOGLE_STT_CREDENTIALS_PATH=

# --- provider endpoints (defaults are the official ones) --------------------------------------
GROQ_BASE_URL=
OPENROUTER_BASE_URL=

# --- folders ----------------------------------------------------------------------------------
# data folder (default <SAM_HOME>\data): key store, sam2.sqlite3, v1's sam.sqlite3 for the import
SAM_DATA_DIR=
# log folder (default %LOCALAPPDATA%\SAM2\logs)
SAM_LOG_DIR=

# Process environment only (not read from .env):
#   SAM_HOME              folder holding this .env and data\ (default: the repository root;
#                         the shortcuts pass it as --home)
#   SAM_BACKGROUND        set by SAM.pyw: 1 = started at sign-in (island only)
#   OPENBLAS_NUM_THREADS  SAM.pyw and dev.ps1 default it to 2 (numpy memory)
#   SAM_ACCEPTANCE_REAL_HOME=1  launcher_startup acceptance uses SAM_HOME instead of a temp home
