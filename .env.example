# Local service and storage
SAM_PORT=8765
SAM_WORKSPACE=./workspace
SAM_DATA_DIR=./data

# auto | ollama | litellm | openrouter | openai
SAM_PROVIDER=auto
SAM_MODEL=qwen3.5:4b
SAM_MODEL_MODE=AUTO
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional local LiteLLM normalization gateway
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_FAST_MODEL=sam-fast
LITELLM_STRONG_MODEL=sam-strong
LITELLM_VISION_MODEL=sam-vision
# LITELLM_MASTER_KEY=

# Optional OpenRouter adapter. Inject keys through the process environment or
# Windows Credential Manager; do not commit a key to this file.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FAST_MODEL=openrouter/auto
OPENROUTER_STRONG_MODEL=openrouter/auto
OPENROUTER_VISION_MODEL=openrouter/auto
# A real model to use when the configured one is unavailable (quota, outage).
# Fallback is always between real models; a mock can never stand in.
# These are startup defaults only. Settings > Models changes both at runtime
# and the change is persisted, so no restart is needed to alter fallback.
# SAM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
SAM_FALLBACK_ENABLED=false
# Which models a run may reach: PREMIUM (the configured chain, and the default
# for every existing installation), BALANCED (free-tier candidates first, then
# that chain), or FREE (free-tier-eligible candidates only, no paid fallback).
# Free-tier is a routing policy, not a billing guarantee: SAM will not choose a
# model it knows to be paid while FREE is active, but a provider's own account
# terms and quotas are theirs to change.
# SAM_ROUTING_PROFILE=PREMIUM
# Keys for the two free-tier-friendly providers. Configure them in
# Settings > Model Providers instead if you would rather not keep them here;
# the local secret store keeps them out of the web root either way.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# Optional automation engine for Workflow Intelligence. Only this URL decides
# where SAM sends imports; a downloaded workflow can never redirect it.
# Set the API key in Settings so it lands in the local secret store instead.
# N8N_BASE_URL=http://localhost:5678
# N8N_API_KEY=
# OPENROUTER_API_KEY=

# guarded | strict | trusted
SAM_PERMISSION_MODE=guarded
SAM_MAX_TOOL_ITERATIONS=8
SAM_COMMAND_TIMEOUT=45
SAM_MAX_FILE_BYTES=1500000
SAM_MAX_OUTPUT_CHARS=24000
SAM_APPROVAL_TTL_MINUTES=30
SAM_DAILY_BUDGET_USD=2
SAM_MONTHLY_BUDGET_USD=30

# Broad controls remain explicitly off until enabled from Settings or here.
SAM_COMPUTER_CONTROL=false
SAM_SCREEN_ACCESS=false

# Trading brain (MetaTrader 5 is read-only; no order execution API is exposed)
SAM_MARKET_DATA_PROVIDER=metatrader5
SAM_DEFAULT_TRADING_THEORY=default
SAM_MINIMUM_RR=1.5
SAM_MONITOR_INTERVAL=10

# Realtime voice: PUSH_TO_TALK | CONVERSATION | ALWAYS_LISTENING | WAKE_WORD
SAM_VOICE_MODE=PUSH_TO_TALK
SAM_VOICE_LANGUAGE=ckb-IQ
SAM_VOICE_VAD_THRESHOLD=0.035
SAM_VOICE_SILENCE_MS=800
SAM_VOICE_WAKE_WORD=SAM
SAM_LOCAL_STT_MODEL=small
# SAM_LOCAL_TTS_VOICE=

# Optional OpenAI Responses API adapter. Prefer setting the key in the process
# environment or Windows Credential Manager instead of writing it here.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Keep these false. Unsafe actions never become an "approve everything" mode.
SAM_ALLOW_UNSAFE_SYSTEM_ACTIONS=false
SAM_ALLOW_CLOUD_SECRET_ACCESS=false

# Optional explicit browser origin list; the active loopback port is used by default.
# SAM_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
